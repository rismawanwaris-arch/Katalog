	}

	function endMs(now) {
		var elapsed = now - epoch;
		var cycles = elapsed < 0 ? 0 : Math.floor(elapsed / span);
		return epoch + (cycles + 1) * span;
	}

	function stamp(ms) {
		var d = new Date(ms);
		return d.getUTCFullYear() + "-" + pad(d.getUTCMonth() + 1) + "-" + pad(d.getUTCDate())
			+ "T" + pad(d.getUTCHours()) + ":" + pad(d.getUTCMinutes()) + ":" + pad(d.getUTCSeconds());
	}

	function render() {
		var now = Date.now();
		var end = endMs(now);
		var left = Math.max(0, end - now);
		var total = Math.floor(left / 1000);
		timer.setAttribute("data-end-date", stamp(end));
		var map = {
			".wd-timer-days .wd-timer-value": String(Math.floor(total / 86400)),
			".wd-timer-hours .wd-timer-value": pad(Math.floor((total % 86400) / 3600)),
			".wd-timer-min .wd-timer-value": pad(Math.floor((total % 3600) / 60)),
			".wd-timer-sec .wd-timer-value": pad(total % 60)
		};
		Object.keys(map).forEach(function (sel) {
			var el = timer.querySelector(sel);
			if (el) el.textContent = map[sel];
		});
	}

	render();
	setInterval(render, 1000);
})();</script>
